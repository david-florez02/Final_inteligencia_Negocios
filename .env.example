# ==================================================
# .env.example - E-Commerce Tecnologico modular
#
# Uso:
#   copy .env.example .env        (desde la raiz del proyecto)
#   copy ..\.env.example .env     (desde backend/, como indica el README)
#
# El backend carga DOS archivos, en este orden, y el ULTIMO gana:
#   1) backend/.env
#   2) .env de la raiz del proyecto
# Las variables de entorno reales del sistema tienen prioridad sobre ambos.
# Basta con rellenar uno de los dos; si existe el de la raiz, manda ese.
# ==================================================

# ==================================================
# OBLIGATORIAS: si falta alguna, el backend no arranca.
# Se copian del panel de Supabase en Settings > API.
# ==================================================

# Project URL (Settings > API > Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica: anon key o, en proyectos nuevos, publishable key (sb_publishable_...).
# El backend la declara pero NO la usa; la consume el frontend (login y sesion).
SUPABASE_KEY=tu-anon-key

# Clave elevada: service_role o, en proyectos nuevos, secret key (sb_secret_...).
# Salta el RLS por completo: usala solo en el backend y nunca la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Settings > API > JWT Settings > JWT Secret (para claves JWT simetricas).
# Puede quedar VACIA: el backend cae al respaldo auth.get_user(), que cuesta una
# llamada HTTP extra por peticion autenticada. Al arrancar, el log avisa si falta.
SUPABASE_JWT_SECRET=

# ==================================================
# OPCIONALES: el backend funciona sin ellas.
# ==================================================

# Puerto del backend. Es informativo: uvicorn se lanza aparte con --port 8000.
PORT=8000

# Origenes extra para CORS, en formato JSON. Por defecto ya se permiten
# http://localhost:4200 y http://127.0.0.1:4200 (ver core/config.py).
# BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Conexion directa a Postgres, util para aplicar los .sql con psycopg sin el panel.
# El backend NO la usa: se comunica con Supabase por su API REST/Auth.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ==================================================
# FRONTEND: Angular no lee variables de entorno. La URL del proyecto y la
# anon key van en frontend/src/environments/environment.ts
# ==================================================
